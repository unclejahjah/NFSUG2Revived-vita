+/* Parses a row of coefficients; the caller holds split_parser. */
+static void vp56_split_parse_row(VP56Context *s, int row)
+{
+    int mb = row * s->mb_width;
+    int end = mb + s->mb_width;
+
+    for (; mb < end; mb++) {
+        if (s->parse_coeff_to(s, s->split_coeff[mb], s->split_selector[mb]) < 0) {
+            atomic_store_explicit(&s->split_error_mb, mb, memory_order_relaxed);
+            break;
+        }
+    }
+    s->split_next_row = row + 1;
+    atomic_store_explicit(&s->split_rows, row + 1, memory_order_release);
+}
+
+/* Helper job: parses rows until all are done or one fails. */
+static void vp56_split_job(void *arg)
+{
+    VP56Context *s = arg;
+
+    for (;;) {
+        int done;
+        if (atomic_flag_test_and_set_explicit(&s->split_parser, memory_order_acquire)) {
+            s->split->wait(s->split->opaque);
+            continue;
+        }
+        done = s->split_next_row >= s->mb_height ||
+               atomic_load_explicit(&s->split_error_mb, memory_order_relaxed) != INT_MAX;
+        if (!done)
+            vp56_split_parse_row(s, s->split_next_row);
+        atomic_flag_clear_explicit(&s->split_parser, memory_order_release);
+        if (done)
+            return;
+    }
+}
+
+/* Waits for a row, parsing rows itself while the parser is free. */
+static void vp56_split_need(VP56Context *s, int row)
+{
+    while (atomic_load_explicit(&s->split_rows, memory_order_acquire) <= row) {
+        if (!atomic_flag_test_and_set_explicit(&s->split_parser, memory_order_acquire)) {
+            int failed = atomic_load_explicit(&s->split_error_mb, memory_order_relaxed) != INT_MAX;
+            if (!failed && s->split_next_row < s->mb_height)
+                vp56_split_parse_row(s, s->split_next_row);
+            atomic_flag_clear_explicit(&s->split_parser, memory_order_release);
+            if (failed)
+                return;
+        } else {
+            s->split->wait(s->split->opaque);
+        }
     }
 }
 
