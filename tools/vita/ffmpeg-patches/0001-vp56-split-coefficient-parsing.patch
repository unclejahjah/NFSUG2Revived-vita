+
+/**
+ * Split decoding: a helper thread parses the separately coded (Huffman) coefficients row by row ahead of the
+ * macroblock loop.
+ */
+typedef struct VP56SplitOps {
+    void *opaque;
+    void (*start)(void *opaque, void (*job)(void *arg), void *arg); /* job(arg) on the helper thread */
+    void (*join)(void *opaque);                                      /* until that job has returned */
+    void (*wait)(void *opaque);                                      /* a short pause for the other thread */
+} VP56SplitOps;
+
 typedef struct VP56RefDc {
     uint8_t not_null_dc;
     VP56Frame ref_frame;
@@ -202,8 +217,21 @@ struct vp56_context {
 
