+
+    /* split decoding */
+    VP56ParseCoeffTo parse_coeff_to;    /* set for coefficients coded apart from the modes */
+    const VP56SplitOps *split;
+    int16_t (*split_coeff)[6][64];      /* per macroblock, zero between frames */
+    int (*split_selector)[6];
+    int split_next_row;                 /* next row to parse, by the holder of split_parser */
+    atomic_int split_rows;              /* rows parsed */
+    atomic_int split_error_mb;          /* first macroblock whose coefficients failed, or INT_MAX */
+    atomic_flag split_parser;
 };
 
+/** Enables split decoding (NULL: off); ops must outlive the codec. */
+void ff_vp56_set_split(AVCodecContext *avctx, const VP56SplitOps *ops);
