VP6: keep the coefficient bit reader in a local copy while parsing a macroblock, so it stays in registers instead
of being loaded and stored for every symbol. Output is unchanged.

diff --git a/libavcodec/vp6.c b/libavcodec/vp6.c
index 5c0eae8..b21a825 100644
--- a/libavcodec/vp6.c
+++ b/libavcodec/vp6.c
@@ -415,14 +415,14 @@ static void vp6_parse_vector_adjustment(VP56Context *s, VP56mv *vect)
  * Read number of consecutive blocks with null DC or AC.
  * This value is < 74.
  */
-static unsigned vp6_get_nb_null(VP56Context *s)
+static unsigned vp6_get_nb_null(GetBitContext *gb)
 {
-    unsigned val = get_bits(&s->gb, 2);
+    unsigned val = get_bits(gb, 2);
     if (val == 2)
-        val += get_bits(&s->gb, 2);
+        val += get_bits(gb, 2);
     else if (val == 3) {
-        val = get_bits1(&s->gb) << 2;
-        val = 6+val + get_bits(&s->gb, 2+val);
+        val = get_bits1(gb) << 2;
+        val = 6+val + get_bits(gb, 2+val);
     }
     return val;
 }
@@ -435,8 +435,11 @@ static int vp6_parse_coeff_huffman(VP56Context *s)
 static int vp6_parse_coeff_huffman_to(VP56Context *s, int16_t (*block_coeff)[64], int *idct_selector)
 {
     VP56Model *model = s->modelp;
-    uint8_t *permute = s->idct_scantable;
-    VLC *vlc_coeff;
+    const uint8_t *permute = s->idct_scantable;
+    const int dequant_ac = s->dequant_ac;
+    /* a local copy, which the compiler keeps in registers */
+    GetBitContext gb = s->gb;
+    const VLCElem *vlc_coeff;
     int coeff, sign, coeff_idx;
     int b, cg, idx;
     int pt = 0;    /* plane type (0 for Y, 1 for U or V) */
@@ -444,7 +447,7 @@ static int vp6_parse_coeff_huffman_to(VP56Context *s, int16_t (*block_coeff)[64]
     for (b=0; b<6; b++) {
         int ct = 0;    /* code type */
         if (b > 3) pt = 1;
-        vlc_coeff = &s->dccv_vlc[pt];
+        vlc_coeff = s->dccv_vlc[pt].table;
 
         for (coeff_idx = 0;;) {
             int run = 1;
@@ -453,31 +456,33 @@ static int vp6_parse_coeff_huffman_to(VP56Context *s, int16_t (*block_coeff)[64]
                 if (coeff_idx)
                     break;
             } else {
-                if (get_bits_left(&s->gb) <= 0)
+                if (get_bits_left(&gb) <= 0) {
+                    s->gb = gb;
                     return AVERROR_INVALIDDATA;
-                coeff = get_vlc2(&s->gb, vlc_coeff->table, FF_HUFFMAN_BITS, 3);
+                }
+                coeff = get_vlc2(&gb, vlc_coeff, FF_HUFFMAN_BITS, 3);
                 if (coeff == 0) {
                     if (coeff_idx) {
                         int pt = (coeff_idx >= 6);
-                        run += get_vlc2(&s->gb, s->runv_vlc[pt].table, FF_HUFFMAN_BITS, 3);
+                        run += get_vlc2(&gb, s->runv_vlc[pt].table, FF_HUFFMAN_BITS, 3);
                         if (run >= 9)
-                            run += get_bits(&s->gb, 6);
+                            run += get_bits(&gb, 6);
                     } else
-                        s->nb_null[0][pt] = vp6_get_nb_null(s);
+                        s->nb_null[0][pt] = vp6_get_nb_null(&gb);
                     ct = 0;
                 } else if (coeff == 11) {  /* end of block */
                     if (coeff_idx == 1)    /* first AC coeff ? */
-                        s->nb_null[1][pt] = vp6_get_nb_null(s);
+                        s->nb_null[1][pt] = vp6_get_nb_null(&gb);
                     break;
                 } else {
                     int coeff2 = ff_vp56_coeff_bias[coeff];
                     if (coeff > 4)
-                        coeff2 += get_bits(&s->gb, coeff <= 9 ? coeff - 4 : 11);
+                        coeff2 += get_bits(&gb, coeff <= 9 ? coeff - 4 : 11);
                     ct = 1 + (coeff2 > 1);
-                    sign = get_bits1(&s->gb);
+                    sign = get_bits1(&gb);
                     coeff2 = (coeff2 ^ -sign) + sign;
                     if (coeff_idx)
-                        coeff2 *= s->dequant_ac;
+                        coeff2 *= dequant_ac;
                     idx = model->coeff_index_to_pos[coeff_idx];
                     block_coeff[b][permute[idx]] = coeff2;
                 }
@@ -486,10 +491,11 @@ static int vp6_parse_coeff_huffman_to(VP56Context *s, int16_t (*block_coeff)[64]
             if (coeff_idx >= 64)
                 break;
             cg = FFMIN(vp6_coeff_groups[coeff_idx], 3);
-            vlc_coeff = &s->ract_vlc[pt][ct][cg];
+            vlc_coeff = s->ract_vlc[pt][ct][cg].table;
         }
         idct_selector[b] = model->coeff_index_to_idct_selector[FFMIN(coeff_idx, 63)];
     }
+    s->gb = gb;
     return 0;
 }
 
