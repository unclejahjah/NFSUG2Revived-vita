# Build output
/build*/
*.velf
*.self
*.vpk
*.elf
*.gxp
!/shaders/gxp/*.gxp
param.sfo

# Generated recompilation (tools/build.py): derived from the game executable
/src/ug2/generated/

# Icon and LiveArea images made from the user's game files (tools/vita/livearea_art.py)
/sce_sys/game/

# Original game binaries and data are never tracked
/binaries/
/vita-data/
*.exe
*.dll
*.EXE
*.DLL
*.dat
*.DAT
*.bun
*.BUN
*.bin
*.BIN
*.mad
*.MAD
*.fng
*.FNG
*.lzc
*.LZC
*.efx
*.EFX
*.ini
*.INI

# Logs and profiles
*.log
*.profraw
*.profdata
*.gcda

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
__pycache__/

# Agent worktrees
.claude/*
!.claude/skills/

# Game folder remembered by tools/build.py
/build-game-dir.txt

# Python packages fetched by tools/recompiler/bootstrap.py
/.pydeps/


# Generated from the game's effects by tools/fx/fxtable.py
/include/winapi/d3d9_fxtables.h

# Host build runtime data
/ug2host-data/

/src/nfsu/generated/

# Estimator test fixtures
!/tools/estimator/tests/data/**/*.log

# Port files that the patterns above would hide: free roam's flag pictures (from nfsu2-web, embedded by
# roam_game.c) and the free roam settings file players copy to the game's scripts folder
!/src/lib/winapi/revived/roam/flags.dat
!/extras/scripts/NFSU2FreeRoam.ini
